# =============================================================
# Cosmetics E-Commerce System — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# ----- PostgreSQL -----
POSTGRES_DB=cosmetics
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_secret

# ----- Odoo -----
ODOO_PORT=8069
DB_PORT=5432

# ----- PayPal -----
# Get credentials from https://developer.paypal.com/
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox

# ----- Firebase Cloud Messaging -----
# Get server key from Firebase Console → Project Settings → Cloud Messaging
FIREBASE_SERVER_KEY=your_firebase_server_key

# ----- API Security -----
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_SECRET=change-me-to-a-random-64-character-hex-string

# ----- Flutter App -----
# Set this to your Odoo server URL (used in Flutter app constants)
FLUTTER_API_BASE_URL=http://localhost:8069
