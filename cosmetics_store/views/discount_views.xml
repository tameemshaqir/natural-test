<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Discount Tree View -->
    <record id="cosmetics_discount_tree" model="ir.ui.view">
        <field name="name">cosmetics.discount.tree</field>
        <field name="model">cosmetics.discount</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="usage_count"/>
                <field name="usage_limit"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Discount Form View -->
    <record id="cosmetics_discount_form" model="ir.ui.view">
        <field name="name">cosmetics.discount.form</field>
        <field name="model">cosmetics.discount</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Discount Details">
                            <field name="code"/>
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="max_discount"/>
                            <field name="min_order_amount"/>
                        </group>
                        <group string="Validity">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="usage_limit"/>
                            <field name="usage_count"/>
                            <field name="per_customer_limit"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="is_public"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Applicable Products">
                            <field name="applicable_products">
                                <tree>
                                    <field name="name"/>
                                    <field name="list_price"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Applicable Categories">
                            <field name="applicable_categories">
                                <tree>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cosmetics_discount" model="ir.actions.act_window">
        <field name="name">Coupons &amp; Discounts</field>
        <field name="res_model">cosmetics.discount</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
