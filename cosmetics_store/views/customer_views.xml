<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Form Extension -->
    <record id="res_partner_form_cosmetics" model="ir.ui.view">
        <field name="name">res.partner.form.cosmetics</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Cosmetics Profile" name="cosmetics_profile">
                    <group>
                        <group string="Skin Profile">
                            <field name="skin_type"/>
                            <field name="skin_concerns" widget="many2many_tags"/>
                            <field name="allergies"/>
                        </group>
                        <group string="Personal Info">
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                        </group>
                    </group>
                    <group>
                        <group string="Loyalty Program">
                            <field name="loyalty_points"/>
                            <field name="loyalty_tier"/>
                        </group>
                        <group string="Referral">
                            <field name="referral_code"/>
                            <field name="referred_by"/>
                        </group>
                    </group>
                    <group string="Preferences">
                        <field name="preferred_brands" widget="many2many_tags"/>
                        <field name="firebase_token"/>
                    </group>
                    <notebook>
                        <page string="Wishlist">
                            <field name="wishlist_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="list_price"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Subscriptions">
                            <field name="subscription_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="plan_id"/>
                                    <field name="status"/>
                                    <field name="recurring_price"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Reviews">
                            <field name="review_ids">
                                <tree>
                                    <field name="product_id"/>
                                    <field name="rating"/>
                                    <field name="title"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
