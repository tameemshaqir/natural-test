<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Tree View -->
    <record id="cosmetics_subscription_tree" model="ir.ui.view">
        <field name="name">cosmetics.subscription.tree</field>
        <field name="model">cosmetics.subscription</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="plan_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status == 'paused'"
                       decoration-danger="status == 'cancelled'"/>
                <field name="start_date"/>
                <field name="next_billing_date"/>
                <field name="recurring_price"/>
            </tree>
        </field>
    </record>

    <!-- Subscription Form View -->
    <record id="cosmetics_subscription_form" model="ir.ui.view">
        <field name="name">cosmetics.subscription.form</field>
        <field name="model">cosmetics.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_pause" string="Pause" type="object"
                            invisible="status != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            class="btn-danger"
                            invisible="status in ('cancelled', 'expired')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="plan_id"/>
                            <field name="recurring_price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="next_billing_date"/>
                            <field name="end_date"/>
                            <field name="total_orders"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="list_price"/>
                                    <field name="cosmetic_category"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Orders">
                            <field name="order_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Subscription Plan Views -->
    <record id="cosmetics_subscription_plan_tree" model="ir.ui.view">
        <field name="name">cosmetics.subscription.plan.tree</field>
        <field name="model">cosmetics.subscription.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="price"/>
                <field name="duration_months"/>
                <field name="max_products"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="cosmetics_subscription_plan_form" model="ir.ui.view">
        <field name="name">cosmetics.subscription.plan.form</field>
        <field name="model">cosmetics.subscription.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="price"/>
                            <field name="duration_months"/>
                            <field name="max_products"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_cosmetics_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">cosmetics.subscription</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_cosmetics_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">cosmetics.subscription.plan</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
