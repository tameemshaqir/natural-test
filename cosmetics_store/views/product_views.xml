<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View Extension -->
    <record id="product_template_form_cosmetics" model="ir.ui.view">
        <field name="name">product.template.form.cosmetics</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Cosmetics Info" name="cosmetics_info">
                    <group>
                        <group string="Product Details">
                            <field name="cosmetic_category"/>
                            <field name="brand_id"/>
                            <field name="skin_type"/>
                            <field name="volume_ml"/>
                        </group>
                        <group string="Certifications">
                            <field name="is_organic"/>
                            <field name="is_vegan"/>
                            <field name="is_cruelty_free"/>
                        </group>
                    </group>
                    <group string="Ingredients &amp; Usage">
                        <field name="ingredients" placeholder="List all ingredients..."/>
                        <field name="usage_instructions" placeholder="How to use this product..."/>
                    </group>
                    <group string="Subscription">
                        <field name="is_subscription_eligible"/>
                        <field name="subscription_price" attrs="{'invisible': [('is_subscription_eligible', '=', False)]}"/>
                    </group>
                </page>
                <page string="Shades" name="shades">
                    <field name="shade_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="color_code"/>
                            <field name="extra_price"/>
                            <field name="active"/>
                        </tree>
                    </field>
                </page>
                <page string="Reviews" name="reviews">
                    <group>
                        <group>
                            <field name="rating_average"/>
                            <field name="review_count"/>
                        </group>
                    </group>
                    <field name="review_ids">
                        <tree>
                            <field name="customer_id"/>
                            <field name="rating"/>
                            <field name="title"/>
                            <field name="is_verified_purchase"/>
                            <field name="is_approved"/>
                            <field name="create_date"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Brand Views -->
    <record id="cosmetics_brand_tree" model="ir.ui.view">
        <field name="name">cosmetics.brand.tree</field>
        <field name="model">cosmetics.brand</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="country_id"/>
                <field name="website"/>
                <field name="is_featured"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="cosmetics_brand_form" model="ir.ui.view">
        <field name="name">cosmetics.brand.form</field>
        <field name="model">cosmetics.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Brand Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="country_id"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group>
                            <field name="is_featured"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Products">
                            <field name="product_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="list_price"/>
                                    <field name="cosmetic_category"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Brand Action -->
    <record id="action_cosmetics_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">cosmetics.brand</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Product Review Views -->
    <record id="product_review_tree" model="ir.ui.view">
        <field name="name">product.review.tree</field>
        <field name="model">product.review</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id"/>
                <field name="customer_id"/>
                <field name="rating" widget="priority"/>
                <field name="title"/>
                <field name="is_verified_purchase"/>
                <field name="is_approved"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="action_product_review" model="ir.actions.act_window">
        <field name="name">Product Reviews</field>
        <field name="res_model">product.review</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
