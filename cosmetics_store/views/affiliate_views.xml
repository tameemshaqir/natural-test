<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Affiliate Tree View -->
    <record id="cosmetics_affiliate_tree" model="ir.ui.view">
        <field name="name">cosmetics.affiliate.tree</field>
        <field name="model">cosmetics.affiliate</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="referral_code"/>
                <field name="commission_rate"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status == 'pending'"
                       decoration-danger="status == 'suspended'"/>
                <field name="total_referrals"/>
                <field name="total_earnings"/>
                <field name="pending_payout"/>
            </tree>
        </field>
    </record>

    <!-- Affiliate Form View -->
    <record id="cosmetics_affiliate_form" model="ir.ui.view">
        <field name="name">cosmetics.affiliate.form</field>
        <field name="model">cosmetics.affiliate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight"
                            invisible="status != 'pending'"/>
                    <button name="action_suspend" string="Suspend" type="object"
                            invisible="status != 'active'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="referral_code"/>
                            <field name="commission_rate"/>
                            <field name="bank_account"/>
                        </group>
                        <group>
                            <field name="total_referrals"/>
                            <field name="total_earnings"/>
                            <field name="pending_payout"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Referrals">
                            <field name="referral_ids">
                                <tree>
                                    <field name="customer_id"/>
                                    <field name="order_id"/>
                                    <field name="order_amount"/>
                                    <field name="commission_amount"/>
                                    <field name="status" widget="badge"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payouts">
                            <field name="payout_ids">
                                <tree>
                                    <field name="amount"/>
                                    <field name="payment_method"/>
                                    <field name="status" widget="badge"/>
                                    <field name="payment_reference"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cosmetics_affiliate" model="ir.actions.act_window">
        <field name="name">Affiliates</field>
        <field name="res_model">cosmetics.affiliate</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
